<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
  THE LIST WIDGETS' LAYOUT — shared by Next 3 days, This week and Work week,
  which differ only in how many of these rows they fill.

  RemoteViews cannot build a list, so the rows are FIXED: seven of them (a
  whole week, the longest span any widget asks for), all starting hidden, and
  filled one by one by CalendarWidgetProvider. Adding a row here means bumping
  MAX_ROWS and ROW_IDS there — the two are one declaration split across two
  files by the platform, not by choice.

  Every colour is set at bind time from the snapshot's palette (the reader's
  theme, as the app resolved it), so nothing is hard-coded here. The root
  carries the id the click handler and the background both address, which is
  why it is the same id in the Today layout.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendar_widget_click"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

