<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
  THE WIDGET'S LAYOUT.

  RemoteViews cannot build a list, so the rows are FIXED: five of them, all
  starting hidden, filled and revealed one by one by CalendarWidgetProvider.
  Adding a row here means bumping MAX_ROWS and ROW_IDS there — the two are one
  declaration split across two files by the platform, not by choice.

  Every colour is set at bind time from the snapshot's palette (the reader's
  theme, as the app resolved it), so nothing is hard-coded here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendar_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

  <TextView
      android:id="@+id/calendar_widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:ellipsize="end"
      android:textSize="12sp"
      android:textStyle="bold"
      tools:text="Personal" />

  <TextView
      android:id="@+id/calendar_widget_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingTop="8dp"
      android:textSize="13sp"
      android:text="@string/calendar_widget_empty"
      android:visibility="gone" />

  <LinearLayout
      android:id="@+id/calendar_widget_row_0"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:paddingTop="4dp"
      android:visibility="gone">

    <LinearLayout
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

      <TextView
          android:id="@+id/calendar_widget_date_0"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textSize="15sp"
          android:textStyle="bold"
          tools:text="12" />

      <TextView
          android:id="@+id/calendar_widget_weekday_0"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textSize="9sp"
          android:textStyle="bold"
          tools:text="MON" />
    </LinearLayout>

    <TextView
        android:id="@+id/calendar_widget_note_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="13sp"
        tools:text="Dentist, 14:00" />
  </LinearLayout>

  <LinearLayout
      android:id="@+id/calendar_widget_row_1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:paddingTop="4dp"
      android:visibility="gone">

    <LinearLayout
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

      <TextView
          android:id="@+id/calendar_widget_date_1"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textSize="15sp"
          android:textStyle="bold"
          tools:text="12" />

      <TextView
          android:id="@+id/calendar_widget_weekday_1"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textSize="9sp"
          android:textStyle="bold"
          tools:text="MON" />
    </LinearLayout>

    <TextView
        android:id="@+id/calendar_widget_note_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="13sp"
        tools:text="Dentist, 14:00" />
  </LinearLayout>

  <LinearLayout
      android:id="@+id/calendar_widget_row_2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:paddingTop="4dp"
      android:visibility="gone">

    <LinearLayout
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
