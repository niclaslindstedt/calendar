{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calendar",
  "mainBinaryName": "calendar",
  "version": "../../package.json",
  "identifier": "dev.local.calendar",
  "build": {
    "frontendDist": "./placeholder"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../webroot": "webroot"
    },
    "category": "Productivity",
    "shortDescription": "a local-first wall calendar",
    "longDescription": "A local-first wall calendar: a month view with week numbers and name days, a week planner and a day list, and short notes on any day. Your notes stay on your machine.",
    "copyright": "Copyright © Niclas Lindstedt",
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
